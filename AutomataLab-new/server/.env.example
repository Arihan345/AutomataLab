# Copy to .env and fill in real values. .env is gitignored — never commit it.

# PostgreSQL connection string
DATABASE_URL="postgresql://user:password@localhost:5432/automatalab?schema=public"

# Origin allowed to call this API (the frontend's URL). Defaults to
# http://localhost:5173 if unset.
CORS_ORIGIN="http://localhost:5173"

# Port to listen on. Most managed platforms (Render/Railway) inject this
# automatically; only set it manually for local overrides. Defaults to 4000.
PORT=4000
